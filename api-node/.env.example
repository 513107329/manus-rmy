ENV=develop
LOG_LEVEL=info
LOG_FILE=logs/app.log
PORT=8080

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/manus?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_ENDPOINT=
TOS_REGION=
TOS_BUCKET=

SANDBOX_ADDRESS=
# 留空 = 动态创建沙箱（推荐）；填固定地址则跳过 Docker 创建
SANDBOX_IMAGE=manus-sandbox-node
SANDBOX_NAME_PREFIX=manus-sandbox
SANDBOX_TTL_MINUTES=60
SANDBOX_NETWORK=
# 容器内动态创建时必填，与 api-node 同网络，如 manus-network-dev
SANDBOX_CHROME_ARGS=
SANDBOX_HTTPS_PROXY=
SANDBOX_HTTP_PROXY=
SANDBOX_NO_PROXY=

APP_CONFIG_FILEPATH=app_config.yaml
STORAGE_MODE=local
