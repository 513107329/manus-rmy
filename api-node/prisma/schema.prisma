generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id               String    @id @db.VarChar(255)
  sandboxId        String?   @map("sandbox_id") @db.VarChar(255)
  taskId           String?   @map("task_id") @db.VarChar(255)
  title            String    @default("") @db.VarChar(255)
  unreadMsgCount   Int       @default(0) @map("unread_msg_count")
  latestMsg        String    @default("") @map("latest_msg") @db.Text
  latestMessageAt  DateTime? @map("latest_message_at")
  events           Json      @default("[]")
  files            Json      @default("[]")
  memories         Json      @default("{}")
  status           String    @default("pending") @db.VarChar(255)
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@map("sessions")
}

model File {
  id        String   @id @db.VarChar(255)
  filename  String   @default("") @db.VarChar(255)
  filepath  String   @default("") @db.VarChar(255)
  key       String   @default("") @db.VarChar(255)
  extension String   @default("") @db.VarChar(255)
  mimeType  String   @default("") @map("mime_type") @db.VarChar(255)
  size      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("files")
}

model User {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @default("") @db.VarChar(255)
  email     String   @default("") @db.VarChar(255)
  password  String   @default("") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}
