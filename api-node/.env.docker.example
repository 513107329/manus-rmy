# Docker 联调：动态创建沙箱（SANDBOX_ADDRESS 留空）
ENV=develop
LOG_LEVEL=info
PORT=8080

DATABASE_URL=postgresql://postgres:postgres@manus-db-dev:5432/manus?schema=public
REDIS_HOST=manus-redis-dev
REDIS_PORT=6379
REDIS_DB=0

# 留空 = chat 时通过 Docker API 动态创建 sandbox-node 容器
SANDBOX_ADDRESS=
SANDBOX_IMAGE=sandbox-node-dev
SANDBOX_NAME_PREFIX=sandbox-node-dev
SANDBOX_TTL_MINUTES=60
# 必须与 api-node 容器所在网络一致
SANDBOX_NETWORK=manus-network-dev

APP_CONFIG_FILEPATH=app_config.yaml
STORAGE_MODE=local
