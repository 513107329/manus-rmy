# 项目基础设置
ENV=development
LOG_LEVEL=DEBUG
APP_CONFIG_FILEPATH = config.py

# 数据库相关设置
SQL_ALCHEMY_DATABASE_URL = 'postgresql+asyncpg://postgres:postgres@localhost:5432/manus'

# Redis相关设置
REDIS_HOST='localhost'
REDIS_PORT='6379'
REDIS_DB=0
REDIS_PASSWORD=''

# 火山配置
TOS_ENDPOINT = "tos-cn-shanghai.volces.com"
TOS_REGION = "cn-shanghai"
TOS_BUCKET = "soon-web"

# 沙箱配置
SANDBOX_ADDRSS =
SANDBOX_IMAGE = sandbox-dev
SANDBOX_NAME_PREFIX = sandbox-dev
SANDBOX_TTL_MINUTES = 60
SANDBOX_NETWORK = manus-network-dev
SANDBOX_CHROME_ARGS = 
SANDBOX_HTTPS_PROXY = 
SANDBOX_HTTP_PROXY = 
SANDBOX_NO_PROXY = 